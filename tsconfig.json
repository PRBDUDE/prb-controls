/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "compileOnSave": false,
  "compilerOptions": {
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "preserve",
    "paths": {
      "@core/*": [
        "./src/app/core/content/*",
        "./src/app/core/card/card-body/*",
        "./src/app/core/card/card-container/*",
        "./src/app/core/card/card-header/*",
        "./src/app/core/code-coloring/class-name/*",
        "./src/app/core/code-coloring/html-attribute/*",
        "./src/app/core/code-coloring/html-tag/*",
        "./src/app/core/code-coloring/number-value/*",
        "./src/app/core/code-coloring/user-tag/*",
        "./src/app/core/footer/*",
        "./src/app/core/header/*",
        "./src/app/core/jelly-container/*",
        "./src/app/core/layout/*",
        "./src/app/core/path-not-found/*",
        "./src/app/core/section/*",
        "./src/app/core/services/*",
        "./src/app/core/theme-toggle/*",
        "./src/app/core/*"
      ],
      "@control/*": [
        "./src/app/control/pain-scale-selector/*",
        "./src/app/control/star-rating/*",
        "./src/app/control/*"
      ]
    }
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true
  },
  "files": [],
  "references": [
    {
      "path": "./tsconfig.app.json"
    },
    {
      "path": "./tsconfig.spec.json"
    }
  ]
}
